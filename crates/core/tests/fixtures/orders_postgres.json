{
  "format": 1,
  "target": "postgres",
  "namespaces": [{ "id": "n_public", "name": "public" }],
  "areas": [{ "id": "a_sales", "name": "sales", "colour": "#7c3aed" }],
  "tables": [
    {
      "id": "t_customers", "namespace": "n_public", "name": "customers", "comment": "People who order.",
      "area": "a_sales",
      "columns": [
        { "id": "c_customers_id", "name": "id", "type": { "name": "bigint" }, "nullable": false,
          "identity": { "always": true } },
        { "id": "c_customers_email", "name": "email", "type": { "name": "text" }, "nullable": false }
      ],
      "primary_key": { "name": "customers_pkey", "columns": ["c_customers_id"] },
      "uniques": [{ "id": "u_customers_email", "name": "customers_email_key", "columns": ["c_customers_email"] }]
    },
    {
      "id": "t_orders", "namespace": "n_public", "name": "orders", "comment": "Every version of every order.",
      "tags": ["scd2"], "area": "a_sales",
      "columns": [
        { "id": "c_orders_order_key", "name": "order_key", "type": { "name": "bigint" }, "nullable": false,
          "identity": { "always": true } },
        { "id": "c_orders_order_no", "name": "order_no", "type": { "name": "text" }, "nullable": false },
        { "id": "c_orders_customer_id", "name": "customer_id", "type": { "name": "bigint" }, "nullable": false },
        { "id": "c_orders_total", "name": "total", "type": { "name": "numeric", "precision": 12, "scale": 2 },
          "nullable": false },
        { "id": "c_orders_valid_from", "name": "valid_from", "type": { "name": "timestamp", "with_time_zone": true },
          "nullable": false },
        { "id": "c_orders_valid_to", "name": "valid_to", "type": { "name": "timestamp", "with_time_zone": true },
          "nullable": true }
      ],
      "primary_key": { "name": "orders_pkey", "columns": ["c_orders_order_key"] },
      "uniques": [{ "id": "u_orders_version", "name": "orders_version_key",
                    "columns": ["c_orders_order_no", "c_orders_valid_from"] }],
      "indexes": [{ "id": "i_orders_customer", "name": "orders_customer_idx",
                    "parts": [{ "column": "c_orders_customer_id" }] }],
      "patterns": { "scd2": { "business_key": ["c_orders_order_no"] } }
    }
  ],
  "relationships": [
    { "id": "r_orders_customer", "name": "orders_customer_fkey",
      "from": { "table": "t_orders", "columns": ["c_orders_customer_id"] },
      "to": { "table": "t_customers", "columns": ["c_customers_id"] },
      "enforced": true, "on_delete": "restrict" }
  ],
  "views": [
    { "id": "v_current_orders", "namespace": "n_public", "name": "current_orders",
      "comment": "Each order as it is now.",
      "definition": "SELECT order_no, customer_id, total FROM orders WHERE valid_to IS NULL",
      "reads": ["t_orders"] }
  ]
}
